{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "api": {
      "entry": ["src/**/*.test.ts", "test/**/*.test.ts"],
      "project": [
        "src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "prisma/**/*.{ts,mts,cts,js,mjs,cjs}",
        "test/**/*.{ts,mts,cts,js,mjs,cjs}"
      ]
    },
    "web": {
      "project": ["src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"]
    }
  }
}
